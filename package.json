{
  "name": "agent-substrate-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "generate": "./scripts/generate.sh",
    "check:generated": "./scripts/generate.sh --check",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "check:packaging": "node scripts/validate-manifests.mjs",
    "check:frontend": "npm --workspace frontend run check",
    "check:backend": "./scripts/check-backend.sh",
    "check": "npm run check:generated && npm run validate:fixtures && npm run check:frontend && npm run check:backend && npm run check:packaging"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  }
}
